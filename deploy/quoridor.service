# Systemd service for the Quoridor AI game server (gunicorn + Flask)
# Install: sudo cp quoridor.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable quoridor

[Unit]
Description=Quoridor AI Game Server
After=network.target

[Service]
User=cs501
Group=cs501
WorkingDirectory=/home/cs501/quoridor
ExecStart=/home/cs501/quoridor/.venv/bin/gunicorn --bind 127.0.0.1:8000 --timeout 120 --workers 1 src.server.app:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
