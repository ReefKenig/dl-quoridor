# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv*/
/env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Training artifacts — metadata-only versioning.
# Model weights are large and regenerable; we version the PROGRESS record
# (runs/<id>/meta.json, config.json, *.log) and figures, not the binaries.
*.pt
*.pth
*.onnx
# replay buffers: legacy .pkl, and the persisted .npz (~110-260 MB per 9x9 run).
# Comments must be on their own line — git does not strip trailing ones, so
# `*.pkl  # note` matches a file literally named that and ignores nothing.
*.pkl
replay_buffer.npz
wandb/

# Legacy / dead checkpoint dirs (kept on disk under runs/, weights ignored above).
# meta.json / config.json / *.log inside runs/ are tracked for versioning.

# Launcher scratch: the pid of a detached run, meaningless on any other machine.
notebook.pid
*_artifacts.tar.gz

# Testing
.pytest_cache/

# Colab
*.ipynb_checkpoints/

# Secrets
.env
